{
  "name": "@house-of-ambers/glass",
  "version": "0.1.0",
  "description": "Frosted glass for dark UIs: a stylesheet and a tiny TypeScript helper, sun and moon glare via chronochrome",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./glass.css": "./dist/glass.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc && cp src/glass.css dist/",
    "prepare": "npm run build",
    "test": "npm run build && node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
